{
  "expo": {
    "name": "EverShelf",
    "slug": "EverShelf",
    "owner": "haopeng",
    "scheme": "evershelf",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haopengyang.evershelf",
      "infoPlist": {}
    },
    "android": {
      "package": "com.haopengyang.evershelf",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "EverShelf uses your photos to set item covers.",
          "cameraPermission": "EverShelf uses the camera to take item cover photos.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-localization"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ca60b5d2-74d3-44ca-9903-5ca6649c6955"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ca60b5d2-74d3-44ca-9903-5ca6649c6955"
    }
  }
}
